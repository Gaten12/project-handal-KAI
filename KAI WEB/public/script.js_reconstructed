        }

        showToast(`${successCount} kereta berhasil disimpan ke Dataset Mentah!`, 'success');
        fetchTrainData(); // Refresh table
    } catch (err) {
        showToast('Terjadi kesalahan saat menyimpan: ' + err.message, 'error');
    } finally {
        hideLoading();
    }
}
}

