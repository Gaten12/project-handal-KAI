async function saveSelectedTrains() {
    if (!tkParsedData || !tkParsedData.rangkaianList) return;

    const selectedCards = [];
    tkParsedData.rangkaianList.forEach((r, idx) => {
        const checkbox = document.getElementById(`tkCheck_${idx}`);
        if (checkbox && checkbox.checked) {
            selectedCards.push({
                data: r,
                namaKA: document.getElementById(`tkNamaKa_${idx}`).value,
                nomorKA: document.getElementById(`tkPilihNoKa_${idx}`).value
            });
        }
    });

    if (selectedCards.length === 0) {
        showToast('Pilih minimal satu rangkaian untuk disimpan', 'error');
        return;
    }

    showLoading(`Menyimpan ${selectedCards.length} rangkaian...`);
    try {
        for (let i = 0; i < selectedCards.length; i++) {
            const item = selectedCards[i];
            const payload = {
                nomorKA: item.nomorKA,
                namaKA: item.namaKA,
                gerbongList: item.data.gerbongList
            };

            const res = await fetch('/api/trains', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                console.error(`Gagal menyimpan KA ${item.namaKA}`);
            }
        }
        showToast(`Berhasil menyimpan ${selectedCards.length} data rangkaian!`, 'success');
        
        // Hide UI back to initial
        document.getElementById('tkResultContainer').style.display = 'none';
        document.getElementById('tkUploadArea').style.display = 'block';
        document.getElementById('tkStep2Indicator').classList.remove('active');
        document.getElementById('tkStep1Indicator').classList.add('active');
        fetchTrainData();
    } catch (e) {
        console.error(e);
        showToast('Terjadi kesalahan saat menyimpan', 'error');
    } finally {
        hideLoading();
    }
}

