async function saveSelectedTrains() {
    if (!tkParsedData || !tkParsedData.rangkaianList || tkParsedData.rangkaianList.length === 0) {
        showToast('Tidak ada data rangkaian untuk disimpan.', 'error');
        return;
    }

    const selectedIdxs = [];
    tkParsedData.rangkaianList.forEach((_, idx) => {
        const checkbox = document.getElementById(`tkCheckbox_${idx}`);
        if (checkbox && checkbox.checked) {
            selectedIdxs.push(idx);
        }
    });

    if (selectedIdxs.length === 0) {
        showToast('Pilih setidaknya satu kereta yang ingin disimpan.', 'error');
        return;
    }

    showLoading(`Menyimpan ${selectedIdxs.length} kereta...`);
    let successCount = 0;
    
    try {
        for (const idx of selectedIdxs) {
            const r = tkParsedData.rangkaianList[idx];
            const selectNoKa = document.getElementById(`tkNoKa_${idx}`);
            const noKA = selectNoKa ? selectNoKa.value : (r.pilihanNoKA[0] || '0');
            const namaKA = document.getElementById(`tkNamaKa_${idx}`).value || "Kereta";

            const newTrain = {
                nomorKA: noKA,
                namaKA: namaKA,
                tanggalPemeriksaan: new Date().toISOString().split('T')[0],
                petugas: "Sistem Import",
                statusSummary: {
                    cctvBaik: 18, cctvTotal: 18,
                    pidsBaik: 20, pidsTotal: 20,
                    runningTextBaik: 18, runningTextTotal: 18,
                    tvBaik: 18, tvTotal: 18,
                    wifiBaik: 18, wifiTotal: 18
                },
                gerbongList: r.gerbongList
            };

            const res = await fetch('/api/trains', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newTrain)
            });

            if (res.ok) {
                successCount++;
                const card = document.getElementById(`tkCheckbox_${idx}`).closest('.tk-card');
                if (card) {
                    card.style.opacity = '0.5';
                    card.style.pointerEvents = 'none';
                }
