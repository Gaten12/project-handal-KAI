async function handleSpkImport(e) {
    e.preventDefault();
    const fileInput = document.getElementById('spkFileInput');
    if (!fileInput.files.length) return;
    
    const file = fileInput.files[0];
    showLoading('Membaca file SPK...');
    
    const reader = new FileReader();
    reader.onload = async (evt) => {
        try {
            const content = evt.target.result;
            const spkData = JSON.parse(content);
            
            const res = await fetch('/api/hasil', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(spkData)
            });
            
            if (!res.ok) throw new Error('Gagal menyimpan SPK ke server');
            
            showToast('File SPK berhasil diimpor!', 'success');
            closeModal('importSpkModal');
            fileInput.value = '';
            
            fetchHasilData(); // Refresh UI
        } catch (err) {
            showToast('Format file tidak valid atau gagal simpan: ' + err.message, 'error');
        } finally {
            hideLoading();
        }
    };
    reader.readAsText(file);
