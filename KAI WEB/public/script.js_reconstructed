    showLoading(`Menyimpan ${selectedCards.length} rangkaian...`);
    try {
        for (let i = 0; i < selectedCards.length; i++) {
            const item = selectedCards[i];
            const payload = {
                nomorKA: item.nomorKA,
                namaKA: item.namaKA,
                gerbongList: item.data.gerbongList
            };

            const res = await fetch('/api/trains', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!res.ok) {
                console.error(`Gagal menyimpan KA ${item.namaKA}`);
            }
        }
        showToast(`Berhasil menyimpan ${selectedCards.length} data rangkaian!`, 'success');
        
        // Hide UI back to initial
        document.getElementById('tkResultContainer').style.display = 'none';
        document.getElementById('tkUploadArea').style.display = 'block';
